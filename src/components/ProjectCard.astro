---
import { t, type Lang } from "../i18n";
import type { Project } from "../projects";

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project: p } = Astro.props;
---

<article class="card">
  <div class="card-head">
    {p.icon ? <img class="project-icon" src={p.icon} alt="" width="40" height="40" loading="lazy" /> : <span class="project-icon placeholder" aria-hidden="true">{p.name.charAt(0)}</span>}
    <h3>{p.name}</h3>
  </div>
  <p>{p.summary[lang]}</p>
  <ul class="tags">{p.tags.map((tag) => <li>{tag}</li>)}</ul>
  <div class="links">
    {p.url && <a href={p.url}>{t[lang].live} →</a>}
    {p.docs && <a href={p.docs}>{t[lang].docs}</a>}
    {p.repo && <a href={p.repo}>{t[lang].code}</a>}
    {!p.url && !p.repo && !p.docs && <span class="private">{t[lang].private}</span>}
  </div>
</article>
