---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PublicationList, { type Pub } from "../components/PublicationList.astro";
import portrait from "../assets/portrait.jpg";
import { cvFor } from "../cv";
import { t, formatMonth, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const cv = cvFor(lang);
const L = t[lang];
const span = (e: { start: string | number; end: string | number }) => `${formatMonth(e.start, lang)} – ${formatMonth(e.end, lang)}`;
type Entry = { title: string; organisation: string; start?: string | number; end?: string | number; location?: string; details?: string; link?: string };
const when = (e: Entry) => [e.start !== undefined && e.end !== undefined ? span(e as { start: string; end: string }) : null, e.location].filter(Boolean).join(" · ");
const contact = cv.contact as Record<string, string | undefined>;
---

<Base lang={lang} path="/cv/" title={L.cv} description={`${cv.name}: ${cv.tagline}`}>
  <header class="cv-head">
    <Image class="portrait" src={portrait} alt={cv.name} width={240} height={240} />
    <div>
      <h1>{cv.name}</h1>
      <div class="muted">{cv.tagline}</div>
      <ul class="cv-contact">
        {contact.location && <li>{contact.location}</li>}
        {contact.email && <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>}
        {cv.contact.github && <li><a href={`https://github.com/${cv.contact.github}`}>github.com/{cv.contact.github}</a></li>}
        {cv.contact.linkedin && <li><a href={`https://www.linkedin.com/in/${cv.contact.linkedin}/`}>LinkedIn</a></li>}
        {contact.scholar && <li><a href={`https://scholar.google.com/citations?user=${contact.scholar}`}>Google Scholar</a></li>}
        {cv.contact.orcid && <li><a href={`https://orcid.org/${cv.contact.orcid}`}>ORCID {cv.contact.orcid}</a></li>}
      </ul>
    </div>
    <a class="button primary print-button" href={`/cv/Fadi-Kelada-CV-${lang}.pdf`} download>{L.print}</a>
  </header>
  {L.cvNote && <p class="note">{L.cvNote}</p>}

  <div class="cv-grid">
    <div>
      <section class="cv-section">
        <h2>{L.about}</h2>
        <p style="margin: 0">{cv.about}</p>
      </section>

      {([
        [L.experience, cv.experience],
        [L.education, cv.education],
        [L.volunteering, cv.volunteering ?? []],
      ] as [string, Entry[]][]).filter(([, entries]) => entries.length > 0).map(([title, entries]) => (
        <section class="cv-section">
          <h2>{title}</h2>
          {entries.map((e) => (
            <div class="entry">
              <h3>{e.title}</h3>
              <div class="org">{e.organisation}</div>
              {when(e) && <div class="when">{when(e)}</div>}
              {e.details && <p>{e.details}{e.link && <> <a href={e.link}>→</a></>}</p>}
            </div>
          ))}
        </section>
      ))}

      {cv.projects?.length > 0 && (
        <section class="cv-section">
          <h2>{L.projectsCv}</h2>
          {cv.projects.map((p) => (
            <div class="entry">
              <h3>{p.link ? <a href={p.link}>{p.name}</a> : p.name}</h3>
              <p>{p.details}</p>
            </div>
          ))}
        </section>
      )}

      <section class="cv-section">
        <h2>{L.publications}</h2>
        <PublicationList lang={lang} pubs={cv.publications as Pub[]} />
      </section>
    </div>

    <aside>
      <section class="cv-section">
        <h2>{L.figures}</h2>
        <div class="figures">
          {cv.highlights.map((h) => (
            <div class="figure"><strong>{h.value}</strong><span>{h.label}</span></div>
          ))}
        </div>
      </section>

      <section class="cv-section">
        <h2>{L.achievements}</h2>
        {cv.achievements.map((a) => (
          <div class="achievement"><strong>{a.title}</strong><span>{a.details}</span></div>
        ))}
      </section>

      <section class="cv-section">
        <h2>{L.skills}</h2>
        {cv.skills.map((g) => (
          <div class="skill-group">
            <h3>{g.group}</h3>
            <ul class="tags">{g.items.map((s) => <li>{s}</li>)}</ul>
          </div>
        ))}
      </section>

      <section class="cv-section">
        <h2>{L.languages}</h2>
        {cv.languages.map((l) => (
          <div class="lang-row">
            <span>{l.name}</span>
            <span class="meter" role="img" aria-label={`${l.level} / 5`}><span style={`width: ${(l.level / 5) * 100}%`} /></span>
          </div>
        ))}
      </section>
    </aside>
  </div>
</Base>
